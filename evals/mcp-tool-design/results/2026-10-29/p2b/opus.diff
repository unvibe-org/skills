diff --color -ruN fixtures/p2b_repo/src/tools/trashFiles.ts p2b_out/opus/src/tools/trashFiles.ts
--- fixtures/p2b_repo/src/tools/trashFiles.ts	1970-01-01 01:00:00
+++ p2b_out/opus/src/tools/trashFiles.ts	2026-10-29 16:00:08
@@ -0,0 +1,61 @@
+import { z } from 'zod'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import { drive } from '../drive.js'
+
+// Account destructive: Acme Drive's Trash empties itself after 30 days, so a
+// trashed file is lost without anyone acting. This is why trashing is its own
+// tool and not an action of manage_file: annotations apply to every call, and a
+// destructive manage_file would put every rename and move through confirmation.
+const ACCOUNT_DESTRUCTIVE = {
+  readOnlyHint: false,
+  destructiveHint: true,
+  idempotentHint: false,
+  openWorldHint: false,
+} as const
+
+const MAX_FILES = 50
+
+export function registerTrashFiles(server: McpServer) {
+  server.registerTool(
+    'trash_files',
+    {
+      description:
+        'Move files to the Acme Drive Trash. Use it when the user asks to trash, delete, or throw away files; ' +
+        'find them first with search_files. Trash empties itself after 30 days, and no tool on this server ' +
+        'restores a file from it. Returns one summary line, then each file id that was not trashed with the reason. ' +
+        'To rename a file or move it to another folder, use manage_file instead.',
+      inputSchema: {
+        ids: z
+          .array(z.string().min(1))
+          .min(1)
+          .max(MAX_FILES)
+          .describe(`File ids to move to Trash, as returned by search_files. Up to ${MAX_FILES} per call.`),
+      },
+      annotations: ACCOUNT_DESTRUCTIVE,
+    },
+    async ({ ids }) => {
+      const unique = [...new Set(ids)]
+      const results = await Promise.allSettled(unique.map((id) => drive.trash(id)))
+
+      const refused: string[] = []
+      results.forEach((r, i) => {
+        if (r.status === 'rejected') {
+          const reason = r.reason instanceof Error ? r.reason.message : String(r.reason)
+          refused.push(`- ${unique[i]}: ${reason}`)
+        }
+      })
+      const trashed = unique.length - refused.length
+
+      if (trashed === 0) {
+        const lines = ['Nothing was moved to Trash.', ...refused, 'Check the ids with search_files and try again.']
+        return { isError: true, content: [{ type: 'text' as const, text: lines.join('\n') }] }
+      }
+
+      const summary =
+        `Moved ${trashed} of ${unique.length} files to Trash. ` +
+        'Trash empties itself after 30 days.'
+      const lines = refused.length ? [summary, 'Not trashed:', ...refused] : [summary]
+      return { content: [{ type: 'text' as const, text: lines.join('\n') }] }
+    }
+  )
+}
