diff --color -ruN fixtures/p2b_repo/src/tools/trashFiles.ts p2b_out/haiku/src/tools/trashFiles.ts
--- fixtures/p2b_repo/src/tools/trashFiles.ts	1970-01-01 01:00:00
+++ p2b_out/haiku/src/tools/trashFiles.ts	2026-10-29 15:59:52
@@ -0,0 +1,38 @@
+import { z } from 'zod'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import { drive } from '../drive.js'
+
+export function registerTrashFiles(server: McpServer) {
+  server.registerTool(
+    'trash_files',
+    {
+      description:
+        'Move files to Trash, which empties itself after 30 days. Use it for "throw this away", "trash these", or "delete this"; there is no permanent delete. Returns a summary line and the outcome for each id, so a partly failed batch still reports what was trashed. To rename or move a file use manage_file instead, and to find files use search_files first.',
+      inputSchema: {
+        ids: z
+          .array(z.string().min(1))
+          .min(1)
+          .max(50)
+          .describe('File ids to trash, as returned by search_files. Up to 50 per call.'),
+      },
+      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false },
+    },
+    async ({ ids }) => {
+      const trashed: string[] = []
+      const failed: string[] = []
+      for (const id of ids) {
+        try {
+          await drive.trash(id)
+          trashed.push(id)
+        } catch (err) {
+          failed.push(`${id}: not trashed (${(err as Error).message})`)
+        }
+      }
+      const lines = [`Trashed ${trashed.length} of ${ids.length} files.`, ...trashed.map((id) => `${id}: trashed`), ...failed]
+      return {
+        isError: trashed.length === 0,
+        content: [{ type: 'text' as const, text: lines.join('\n') }],
+      }
+    }
+  )
+}
