diff --color -ruN fixtures/p2b_repo/src/tools/trashFiles.ts p2b_out/sonnet/src/tools/trashFiles.ts
--- fixtures/p2b_repo/src/tools/trashFiles.ts	1970-01-01 01:00:00
+++ p2b_out/sonnet/src/tools/trashFiles.ts	2026-10-29 15:59:48
@@ -0,0 +1,31 @@
+import { z } from 'zod'
+import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js'
+import { drive } from '../drive.js'
+
+export function registerTrashFiles(server: McpServer) {
+  server.registerTool(
+    'trash_files',
+    {
+      description:
+        'Move files to Trash. Use it for "throw this away" or "delete these files"; to rename or move a file use manage_file instead. Trash empties itself after 30 days, so after that the files are gone for good. Returns one summary line, then each file that could not be trashed with its reason. Find the ids with search_files first.',
+      inputSchema: {
+        ids: z
+          .array(z.string().min(1))
+          .min(1)
+          .max(50)
+          .describe('File ids to move to Trash, as returned by search_files. Up to 50 per call.'),
+      },
+      annotations: { readOnlyHint: false, destructiveHint: true, idempotentHint: false, openWorldHint: false },
+    },
+    async ({ ids }) => {
+      const results = await Promise.allSettled(ids.map((id) => drive.trash(id)))
+      const failed = results.flatMap((r, i) =>
+        r.status === 'rejected' ? [`${ids[i]}: ${(r.reason as Error).message}`] : []
+      )
+      const done = ids.length - failed.length
+      const lines = [`Moved ${done} of ${ids.length} files to Trash.`]
+      if (failed.length) lines.push('Not trashed:', ...failed, 'Check the ids with search_files and retry those.')
+      return { content: [{ type: 'text' as const, text: lines.join('\n') }], isError: done === 0 }
+    }
+  )
+}
